DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=student_attendance_db
PORT=5000

# Frontend origin allowed by CORS (must match your Vite dev server)
FRONTEND_ORIGIN=http://localhost:5173

# ---- Authentication -------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Initial demo-admin credentials used by:  node scripts/seed-admin.js
# Change these BEFORE seeding in any shared or production environment.
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@college.edu
SEED_ADMIN_PASSWORD=Admin@1234
